# Normalize to LF in the repo. Files under docker/ execute inside a Linux
# container, where CRLF in an entrypoint or init script is a runtime failure.
* text=auto eol=lf

*.png binary
*.pdf binary
uv.lock text eol=lf linguist-generated=true

# Vendored CUAD text: byte-exact. Gold spans and cache keys are character
# offsets into these files, so git must never rewrite them.
evals/golden/corpus/full_contract_txt/** -text
