# Copy to .env and adjust. Everything here has a working default; this file
# exists to document what is tunable.

# The compose stack publishes Postgres on 5433, not 5432: a natively installed
# Postgres often owns 5432, and the container healthcheck cannot detect that
# because it runs inside the container.
DOCINTEL_DATABASE_URL=postgresql://docintel:docintel@localhost:5433/docintel
POSTGRES_PORT=5433

# Chunking. Defaults come from the corpus profile in docs/DATA_AUDIT.md.
DOCINTEL_CHUNK_MAX_TOKENS=512
DOCINTEL_CHUNK_MIN_TOKENS=64
DOCINTEL_CHUNK_OVERLAP_TOKENS=64

# Retrieval.
DOCINTEL_RETRIEVAL_TOP_K=10
DOCINTEL_RETRIEVAL_CANDIDATES_PER_RETRIEVER=50
DOCINTEL_RETRIEVAL_RRF_K=60

# Required from M2 onward, not for M1.
# ANTHROPIC_API_KEY=
